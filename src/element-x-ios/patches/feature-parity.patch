+    var body: some View {
+        ElementNavigationStack {
+            List(languages, id: \.self) { code in
+                Button {
+                    service.setLanguage(code)
+                    dismiss()
+                } label: {
+                    HStack(spacing: 12) {
+                        Text(title(code))
+                            .foregroundStyle(.compound.textPrimary)
+                        Spacer()
