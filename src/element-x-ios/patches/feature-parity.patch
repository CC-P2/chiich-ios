diff --git a/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityHTTP.swift b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityHTTP.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cb048bd33f92ad64a4e67b61588b8cccc48982ec
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityHTTP.swift
@@ -0,0 +1,79 @@
+// Copyright 2026 CHIICH.
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+
+/// The pinned SDK has no authenticated Synapse-module request API.
+enum CHIICHIdentityHTTP {
+    static let responseLimit = 16_384
+
+    static func send(_ request: URLRequest) async -> Result<Data, CHIICHIdentityError> {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.urlCache = nil
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.timeoutIntervalForResource = 20
+        configuration.waitsForConnectivity = false
+        let session = URLSession(configuration: configuration, delegate: CHIICHIdentityRedirectBlocker(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        do {
+            let (bytes, response) = try await session.bytes(for: request)
+            try Task.checkCancellation()
+            guard let response = response as? HTTPURLResponse, response.url == request.url,
+                  response.expectedContentLength <= Int64(responseLimit) else { return .failure(.invalidResponse) }
+            var data = Data()
+            for try await byte in bytes {
+                guard data.count < responseLimit else { return .failure(.invalidResponse) }
+                data.append(byte)
+            }
+            try Task.checkCancellation()
+            return classify(data: data, statusCode: response.statusCode)
+        } catch is CancellationError {
+            return .failure(.cancelled)
+        } catch {
+            return .failure(Task.isCancelled ? .cancelled : .uncertain)
+        }
+    }
+
+    static func classify(data: Data, statusCode: Int) -> Result<Data, CHIICHIdentityError> {
+        guard data.count <= responseLimit else { return .failure(.invalidResponse) }
+        if statusCode == 200 { return .success(data) }
+        let response = try? JSONDecoder().decode(MatrixError.self, from: data)
+        switch (statusCode, response?.errcode) {
+        case (401, "M_UNKNOWN_TOKEN"):
+            return .failure(.matrixUnknownToken(softLogout: response?.softLogout ?? false))
+        case (400, "M_INVALID_PARAM"):
+            return .failure(.invalidUsername)
+        case (400, "M_USERNAME_LIMIT_EXCEEDED"):
+            return .failure(.aliasLimit)
+        case (409, "M_CONFLICT"):
+            return .failure(.conflict)
+        case (429, "M_LIMIT_EXCEEDED"):
+            return .failure(.rateLimited)
+        case (404, "M_NOT_FOUND"):
+            return .failure(.notFound)
+        default:
+            return .failure(.unavailable)
+        }
+    }
+
+    private nonisolated struct MatrixError: Decodable {
+        enum CodingKeys: String, CodingKey {
+            case errcode
+            case softLogout = "soft_logout"
+        }
+
+        let errcode: String
+        let softLogout: Bool?
+    }
+}
+
+private final nonisolated class CHIICHIdentityRedirectBlocker: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession,
+                    task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest,
+                    completionHandler: @escaping (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+}
diff --git a/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityModels.swift b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityModels.swift
new file mode 100644
index 0000000000000000000000000000000000000000..cebde77b26bad98713207956980f25afa6a6a5cd
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityModels.swift
@@ -0,0 +1,134 @@
+// Copyright 2026 CHIICH.
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+
+nonisolated enum CHIICHIdentityError: Error, Equatable {
+    case invalidUsername, conflict, aliasLimit, rateLimited, notFound
+    case unavailable, invalidResponse, sessionChanged, cancelled, uncertain
+    case matrixUnknownToken(softLogout: Bool)
+}
+
+/// A mutable public alias, never a Matrix account identifier or a login credential.
+nonisolated struct CHIICHPublicUsername: Hashable, Sendable {
+    let value: String
+
+    static let reserved: Set<String> = Set("""
+    admin administrator administrators support help official chiich element matrix www api
+    login logout register signup signin account accounts settings profile user users username
+    usernames invite invitations home app apps assets bundles config diagnostics health status
+    static wellknown index shortlink
+    """.split(whereSeparator: \.isWhitespace).map(String.init))
+
+    var link: URL {
+        let origin: URL = "https://chiich.one"
+        return origin.appending(path: value)
+    }
+
+    var displayLink: String { "chiich.one/\(value)" }
+
+    var appLink: URL {
+        let origin: URL = "one.chiich.app://user"
+        return origin.appending(path: value)
+    }
+
+    init(_ input: String) throws {
+        guard input.unicodeScalars.count <= 96 else { throw CHIICHIdentityError.invalidUsername }
+        let normalised = input.precomposedStringWithCompatibilityMapping
+        let scalars = normalised.unicodeScalars
+        guard (3...24).contains(scalars.count), scalars.allSatisfy(Self.isAllowed) else {
+            throw CHIICHIdentityError.invalidUsername
+        }
+        let lowercased = normalised.lowercased(with: Locale(identifier: "en_US_POSIX"))
+        let hasLatin = lowercased.unicodeScalars.contains { (97...122).contains($0.value) }
+        let hasCyrillic = lowercased.unicodeScalars.contains { (1072...1103).contains($0.value) || $0.value == 1105 }
+        guard !(hasLatin && hasCyrillic), !Self.reserved.contains(lowercased) else {
+            throw CHIICHIdentityError.invalidUsername
+        }
+        value = lowercased
+    }
+
+    static func fromInvitationURL(_ url: URL) -> Self? {
+        guard let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              components.user == nil, components.password == nil,
+              components.query == nil, components.fragment == nil,
+              components.percentEncodedPath.split(separator: "/", omittingEmptySubsequences: false).count == 2,
+              components.path.hasPrefix("/") else { return nil }
+        switch (components.scheme, components.host?.lowercased()) {
+        case ("https", "chiich.one"):
+            guard components.port == nil || components.port == 443 else { return nil }
+        case ("one.chiich.app", "user"):
+            guard components.port == nil else { return nil }
+        default:
+            return nil
+        }
+        return try? Self(String(components.path.dropFirst()))
+    }
+
+    private static func isAllowed(_ scalar: Unicode.Scalar) -> Bool {
+        (48...57).contains(scalar.value) || (65...90).contains(scalar.value) || (97...122).contains(scalar.value)
+            || (1040...1103).contains(scalar.value) || scalar.value == 1025 || scalar.value == 1105
+    }
+}
+
+nonisolated enum CHIICHIdentityRequest: Equatable, Sendable {
+    case current
+    case rename(CHIICHPublicUsername)
+    case resolve(CHIICHPublicUsername)
+
+    func urlRequest(homeserver: String) throws -> URLRequest {
+        guard var components = URLComponents(string: homeserver), components.scheme == "https",
+              components.user == nil, components.password == nil,
+              components.port == nil || components.port == 443,
+              components.query == nil, components.fragment == nil,
+              components.path.isEmpty || components.path == "/",
+              let host = components.host, ["matrix.chiich.one", "chiich-matrix.onrender.com"].contains(host) else {
+            throw CHIICHIdentityError.unavailable
+        }
+        components.path = "/_synapse/client/chiich/username"
+        if case .resolve(let username) = self { components.path += "/\(username.value)" }
+        guard let url = components.url else { throw CHIICHIdentityError.unavailable }
+
+        var request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 15)
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        switch self {
+        case .current, .resolve:
+            request.httpMethod = "GET"
+        case .rename(let username):
+            request.httpMethod = "PUT"
+            request.httpBody = try JSONEncoder().encode(["username": username.value])
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        }
+        return request
+    }
+}
+
+nonisolated struct CHIICHIdentityResponse: Decodable {
+    let username: String
+
+    func validated() throws -> CHIICHPublicUsername {
+        let alias = try CHIICHPublicUsername(username)
+        guard alias.value == username else { throw CHIICHIdentityError.invalidResponse }
+        return alias
+    }
+}
+
+nonisolated struct CHIICHIdentityRecipient: Decodable, Equatable, Sendable {
+    enum CodingKeys: String, CodingKey {
+        case username
+        case userID = "user_id"
+    }
+
+    let username: String
+    let userID: String
+
+    func validated() throws -> Self {
+        _ = try CHIICHIdentityResponse(username: username).validated()
+        guard Self.isOwnedUserID(userID) else { throw CHIICHIdentityError.invalidResponse }
+        return self
+    }
+
+    static func isOwnedUserID(_ userID: String) -> Bool {
+        userID.utf8.count <= 255 && userID.range(of: "\\A@[^\\s:\\p{C}]+:chat\\.chiich\\.one\\z", options: .regularExpression) != nil
+    }
+}
diff --git a/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityService.swift b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityService.swift
new file mode 100644
index 0000000000000000000000000000000000000000..030644671303c2eabf4e780ddfe307c7eaf34f1a
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHIdentity/CHIICHIdentityService.swift
@@ -0,0 +1,71 @@
+// Copyright 2026 CHIICH.
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+
+/// Shares the existing registry and Matrix session; aliases never create or merge accounts.
+final class CHIICHIdentityService {
+    typealias Request = (CHIICHIdentityRequest) async -> Result<Data, CHIICHIdentityError>
+
+    private let request: Request
+    private let sessionIsCurrent: () -> Bool
+
+    var isSessionCurrent: Bool { sessionIsCurrent() }
+
+    init(request: @escaping Request, isSessionCurrent: @escaping () -> Bool) {
+        self.request = request
+        sessionIsCurrent = isSessionCurrent
+    }
+
+    convenience init?(clientProxy: ClientProxyProtocol) {
+        let accountID = clientProxy.userID
+        let deviceID = clientProxy.deviceID
+        let homeserver = clientProxy.homeserver
+        guard CHIICHIdentityRecipient.isOwnedUserID(accountID),
+              (try? CHIICHIdentityRequest.current.urlRequest(homeserver: homeserver)) != nil else { return nil }
+        self.init(request: { [weak clientProxy] request in
+            guard let clientProxy else { return .failure(.sessionChanged) }
+            return await clientProxy.chiichIdentityRequest(request, accountID: accountID)
+        }, isSessionCurrent: { [weak clientProxy] in
+            guard let clientProxy else { return false }
+            return clientProxy.chiichReceiverAIIsSessionActive && clientProxy.userID == accountID
+                && clientProxy.deviceID == deviceID && clientProxy.homeserver == homeserver
+        })
+    }
+
+    func current() async -> Result<CHIICHPublicUsername, CHIICHIdentityError> {
+        await username(for: .current)
+    }
+
+    func rename(to username: CHIICHPublicUsername) async -> Result<CHIICHPublicUsername, CHIICHIdentityError> {
+        let result = await self.username(for: .rename(username))
+        if case .success(let confirmed) = result, confirmed != username { return .failure(.invalidResponse) }
+        return result
+    }
+
+    func resolve(_ username: CHIICHPublicUsername) async -> Result<CHIICHIdentityRecipient, CHIICHIdentityError> {
+        guard isSessionCurrent, !Task.isCancelled else { return .failure(.sessionChanged) }
+        let result = await request(.resolve(username))
+        guard isSessionCurrent, !Task.isCancelled else { return .failure(.cancelled) }
+        switch result {
+        case .failure(let error): return .failure(error)
+        case .success(let data):
+            do {
+                // Retired aliases deliberately return the owner's current name and unchanged MXID.
+                return try .success(JSONDecoder().decode(CHIICHIdentityRecipient.self, from: data).validated())
+            } catch { return .failure(.invalidResponse) }
+        }
+    }
+
+    private func username(for payload: CHIICHIdentityRequest) async -> Result<CHIICHPublicUsername, CHIICHIdentityError> {
+        guard isSessionCurrent, !Task.isCancelled else { return .failure(.sessionChanged) }
+        let result = await request(payload)
+        guard isSessionCurrent, !Task.isCancelled else { return .failure(.cancelled) }
+        switch result {
+        case .failure(let error): return .failure(error)
+        case .success(let data):
+            do { return try .success(JSONDecoder().decode(CHIICHIdentityResponse.self, from: data).validated()) }
+            catch { return .failure(.invalidResponse) }
+        }
+    }
+}
