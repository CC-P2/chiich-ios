+        var holdWrite = false
+        var readContinuation: CheckedContinuation<Void, Never>?
+        var writeContinuation: CheckedContinuation<Void, Never>?
+        var concurrentWrites = 0
+        var maximumConcurrentWrites = 0
+
+        init() throws {
