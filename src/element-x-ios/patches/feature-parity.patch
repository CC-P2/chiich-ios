diff --git a/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordHTTP.swift b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordHTTP.swift
new file mode 100644
index 0000000000000000000000000000000000000000..75c6062e544bcc65a666dc73301f96ada05452b1
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordHTTP.swift
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+
+enum CHIICHPasswordHTTP {
+    static let maximumResponseBytes = 64_000
+
+    /// One explicit submission only. A transport failure must never automatically repeat a password change.
+    static func send(_ request: URLRequest) async -> Result<CHIICHPasswordResponse, CHIICHPasswordError> {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.urlCache = nil
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.timeoutIntervalForResource = 35
+        configuration.waitsForConnectivity = false
+        let session = URLSession(configuration: configuration, delegate: CHIICHPasswordRedirectBlocker(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        do {
+            let (bytes, response) = try await session.bytes(for: request)
+            try Task.checkCancellation()
+            guard let response = response as? HTTPURLResponse, response.url == request.url,
+                  response.expectedContentLength <= maximumResponseBytes else { return .failure(.outcomeUnknown) }
+            var data = Data()
+            for try await byte in bytes {
+                guard data.count < maximumResponseBytes else { return .failure(.outcomeUnknown) }
+                data.append(byte)
+            }
+            try Task.checkCancellation()
+            return classify(data: data, statusCode: response.statusCode)
+        } catch is CancellationError {
+            return .failure(.cancelled)
+        } catch {
+            return .failure(.outcomeUnknown)
+        }
+    }
+
+    static func classify(data: Data, statusCode: Int) -> Result<CHIICHPasswordResponse, CHIICHPasswordError> {
+        guard data.count <= maximumResponseBytes else { return .failure(.outcomeUnknown) }
+        let error = try? JSONDecoder().decode(MatrixError.self, from: data)
+        if statusCode == 401, error?.errcode == "M_UNKNOWN_TOKEN" {
+            return .failure(.matrixUnknownToken(softLogout: error?.softLogout ?? false))
+        }
+        if statusCode == 401 {
+            guard let challenge = try? JSONDecoder().decode(CHIICHPasswordChallenge.self, from: data), challenge.isValid else {
+                return .failure(.invalidResponse)
+            }
+            return .success(.challenge(challenge))
+        }
+        if statusCode == 200 {
+            guard let result = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+                  result["errcode"] == nil, result["flows"] == nil else { return .failure(.outcomeUnknown) }
+            return .success(.success)
+        }
+        if statusCode == 429 { return .failure(.rateLimited) }
+        if statusCode == 404 || statusCode == 405 { return .failure(.unsupportedServer) }
+        if statusCode == 403 { return .failure(.authenticationRejected) }
+        if statusCode == 400, let code = error?.errcode,
+           code == "M_WEAK_PASSWORD" || code.hasPrefix("M_PASSWORD_") {
+            return .failure(.passwordPolicy)
+        }
+        if (400...499).contains(statusCode) { return .failure(.invalidResponse) }
+        return .failure(.outcomeUnknown)
+    }
+
+    private nonisolated struct MatrixError: Decodable {
+        enum CodingKeys: String, CodingKey {
+            case errcode
+            case softLogout = "soft_logout"
+        }
+
+        let errcode: String
+        let softLogout: Bool?
+    }
+}
+
+private final nonisolated class CHIICHPasswordRedirectBlocker: NSObject, URLSessionTaskDelegate {
+    func urlSession(_ session: URLSession,
+                    task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest,
+                    completionHandler: @escaping (URLRequest?) -> Void) {
+        completionHandler(nil)
+    }
+}
diff --git a/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordModels.swift b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordModels.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c9739e2f7b14dc25de448fdfd91f8d177b96e930
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordModels.swift
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+import MatrixRustSDK
+
+nonisolated enum CHIICHPasswordCapability: Equatable, Sendable {
+    case allowed
+    case disabled
+    case unknown
+}
+
+nonisolated enum CHIICHPasswordError: Error, Equatable, Sendable {
+    case invalidPassword
+    case passwordsDoNotMatch
+    case passwordTooLong
+    case passwordPolicy
+    case currentPasswordRequired
+    case authenticationRejected
+    case authenticationIncomplete
+    case unsupportedAuthentication
+    case unsupportedServer
+    case serverDisabled
+    case sessionChanged
+    case expiredChallenge
+    case rateLimited
+    case invalidResponse
+    case outcomeUnknown
+    case cancelled
+    case matrixUnknownToken(softLogout: Bool)
+}
+
+/// No token or password belongs in a screen's identity or its browser URL.
+nonisolated struct CHIICHPasswordContext: Equatable, Sendable {
+    let accountID: String
+    let deviceID: String
+    let origin: URL
+
+    init?(accountID: String, deviceID: String, homeserver: String) {
+        guard accountID.utf8.count <= 1024,
+              accountID.hasSuffix(":chat.chiich.one"),
+              accountID.range(of: "^@[^\\s:]+:chat\\.chiich\\.one$", options: .regularExpression) != nil,
+              !deviceID.isEmpty, deviceID.utf8.count <= 255,
+              let components = URLComponents(string: homeserver),
+              components.scheme == "https", let host = components.host?.lowercased(),
+              ["matrix.chiich.one", "chiich-matrix.onrender.com"].contains(host),
+              components.port == nil || components.port == 443,
+              components.user == nil, components.password == nil,
+              components.path.isEmpty || components.path == "/",
+              components.query == nil, components.fragment == nil,
+              let origin = URL(string: "https://\(host)") else { return nil }
+        self.accountID = accountID
+        self.deviceID = deviceID
+        self.origin = origin
+    }
+
+    func ssoURL(session: String) -> URL? {
+        guard CHIICHPasswordChallenge.isValidSession(session),
+              var components = URLComponents(url: origin, resolvingAgainstBaseURL: false) else { return nil }
+        components.path = "/_matrix/client/v3/auth/m.login.sso/fallback/web"
+        components.queryItems = [URLQueryItem(name: "session", value: session)]
+        return components.url
+    }
+}
+
+nonisolated enum CHIICHPasswordAuth: Sendable, CustomStringConvertible, CustomDebugStringConvertible {
+    // Reuse the SDK's password UIA value. The FFI has no general UIA/set-password API.
+    case password(AuthDataPasswordDetails)
+    case session(String)
+
+    var sessionID: String {
+        switch self {
+        case .password(let details): details.session
+        case .session(let session): session
+        }
+    }
+
+    var description: String { "CHIICHPasswordAuth(<redacted>)" }
+    var debugDescription: String { description }
+}
+
+/// Never persist a request; redact even accidental diagnostic descriptions.
+nonisolated struct CHIICHPasswordRequest: Sendable, CustomStringConvertible, CustomDebugStringConvertible {
+    let newPassword: String
+    let authentication: CHIICHPasswordAuth?
+
+    var description: String { "CHIICHPasswordRequest(<redacted>)" }
+    var debugDescription: String { description }
+
+    static func validationError(newPassword: String, confirmation: String) -> CHIICHPasswordError? {
+        guard !newPassword.isEmpty else { return .invalidPassword }
+        guard newPassword.unicodeScalars.count <= 512 else { return .passwordTooLong }
+        // Swift String equality is canonically equivalent; passwords must match byte-for-byte.
+        guard newPassword.utf8.elementsEqual(confirmation.utf8) else { return .passwordsDoNotMatch }
+        return nil
+    }
+
+    func urlRequest(context: CHIICHPasswordContext) throws -> URLRequest {
+        guard !newPassword.isEmpty else { throw CHIICHPasswordError.invalidPassword }
+        guard newPassword.unicodeScalars.count <= 512 else { throw CHIICHPasswordError.passwordTooLong }
+        var body: [String: Any] = ["new_password": newPassword, "logout_devices": false]
+        if let authentication {
+            guard CHIICHPasswordChallenge.isValidSession(authentication.sessionID) else { throw CHIICHPasswordError.expiredChallenge }
+            switch authentication {
+            case .password(let details):
+                guard details.identifier.utf8.elementsEqual(context.accountID.utf8), !details.password.isEmpty else { throw CHIICHPasswordError.currentPasswordRequired }
+                guard details.password.unicodeScalars.count <= 512 else { throw CHIICHPasswordError.passwordTooLong }
+                body["auth"] = ["type": "m.login.password",
+                                "identifier": ["type": "m.id.user", "user": context.accountID],
+                                "password": details.password,
+                                "session": details.session]
+            case .session(let session):
+                body["auth"] = ["session": session]
+            }
+        }
+        var request = URLRequest(url: context.origin.appending(path: "_matrix/client/v3/account/password"),
+                                 cachePolicy: .reloadIgnoringLocalCacheData,
+                                 timeoutInterval: 25)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        request.setValue("no-store", forHTTPHeaderField: "Cache-Control")
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+        return request
+    }
+}
+
+nonisolated struct CHIICHPasswordChallenge: Decodable, Equatable, Sendable {
+    nonisolated struct Flow: Decodable, Equatable, Sendable {
+        let stages: [String]
+    }
+
+    nonisolated enum Stage: String, Hashable, Sendable {
+        case password = "m.login.password"
+        case sso = "m.login.sso"
+    }
+
+    let session: String
+    let flows: [Flow]
+    let completed: [String]?
+    let errcode: String?
+
+    static func isValidSession(_ value: String) -> Bool {
+        !value.isEmpty && value.utf8.count <= 2048 && !value.unicodeScalars.contains { CharacterSet.controlCharacters.contains($0) }
+    }
+
+    var isValid: Bool {
+        Self.isValidSession(session) && !flows.isEmpty && flows.count <= 16
+            && flows.allSatisfy { !$0.stages.isEmpty && $0.stages.count <= 8 && $0.stages.allSatisfy { !$0.isEmpty && $0.utf8.count <= 128 } }
+            && (completed?.count ?? 0) <= 32
+            && (completed?.allSatisfy { $0.utf8.count <= 128 } ?? true)
+    }
+
+    private var remainingFlows: [[String]] {
+        let completed = Set(completed ?? [])
+        return flows.map { $0.stages.filter { !completed.contains($0) } }
+    }
+
+    /// Only use a flow the app can finish. Unknown UIA is never treated as password/SSO.
+    var availableStages: Set<Stage> {
+        Set(remainingFlows.filter { $0.allSatisfy { Stage(rawValue: $0) != nil } }.compactMap { $0.first.flatMap(Stage.init(rawValue:)) })
+    }
+
+    var isComplete: Bool {
+        remainingFlows.contains(where: \.isEmpty)
+    }
+
+    var canContinue: Bool {
+        isComplete || !availableStages.isEmpty
+    }
+}
+
+nonisolated enum CHIICHPasswordResponse: Equatable, Sendable {
+    case success
+    case challenge(CHIICHPasswordChallenge)
+}
+
+/// The nonce belongs to this presentation and this pending UIA attempt, never a login callback.
+nonisolated struct CHIICHPasswordSSOPresentation: Identifiable, Equatable, Sendable {
+    let id: UUID
+    let url: URL
+}
+
+nonisolated enum CHIICHPasswordSessionBinding {
+    static func matches(current: Session, initiating: Session, homeserver: String, initiatingHomeserver: String, isActive: Bool) -> Bool {
+        guard isActive, current.oauthData == nil, initiating.oauthData == nil,
+              homeserver.utf8.elementsEqual(initiatingHomeserver.utf8) else { return false }
+        return current == initiating
+            && current.userId.utf8.elementsEqual(initiating.userId.utf8)
+            && current.deviceId.utf8.elementsEqual(initiating.deviceId.utf8)
+            && current.accessToken.utf8.elementsEqual(initiating.accessToken.utf8)
+            && current.homeserverUrl.utf8.elementsEqual(initiating.homeserverUrl.utf8)
+    }
+}
diff --git a/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordService.swift b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordService.swift
new file mode 100644
index 0000000000000000000000000000000000000000..2f2548c3c436b14ae2b2354a0377fe74d36b4a27
--- /dev/null
+++ b/ElementX/Sources/Services/CHIICHPassword/CHIICHPasswordService.swift
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial.
+
+import Foundation
+
+/// An in-memory adapter for the server's standard UIA transaction, not a login/session implementation.
+final class CHIICHPasswordService {
+    typealias Submission = Result<CHIICHPasswordResponse, CHIICHPasswordError>
+
+    let context: CHIICHPasswordContext
+    private let sessionIsCurrent: () -> Bool
+    private let capabilityRequest: () async -> CHIICHPasswordCapability
+    private let submitRequest: (CHIICHPasswordRequest) async -> Submission
+
+    private var capability: CHIICHPasswordCapability?
+    private var operationID = UUID()
+    private var pendingPassword: String?
+    private var challenge: CHIICHPasswordChallenge?
+    private var browserNonce: UUID?
+    private var returnedBrowserNonce: UUID?
+    private var isStarting = false
+    private var isSubmitting = false
+    private var isClosed = false
+
+    init(context: CHIICHPasswordContext,
+         sessionIsCurrent: @escaping () -> Bool,
+         capabilityRequest: @escaping () async -> CHIICHPasswordCapability,
+         submitRequest: @escaping (CHIICHPasswordRequest) async -> Submission) {
+        self.context = context
+        self.sessionIsCurrent = sessionIsCurrent
+        self.capabilityRequest = capabilityRequest
+        self.submitRequest = submitRequest
+    }
+
+    func prepare() async -> Result<CHIICHPasswordCapability, CHIICHPasswordError> {
+        guard !isClosed, sessionIsCurrent(), !Task.isCancelled else { return .failure(.sessionChanged) }
+        if let capability { return .success(capability) }
+        let currentOperation = operationID
+        let result = await capabilityRequest()
+        guard !isClosed, operationID == currentOperation, sessionIsCurrent(), !Task.isCancelled else { return .failure(.sessionChanged) }
+        capability = result
+        return .success(result)
+    }
+
+    func begin(newPassword: String, confirmation: String) async -> Submission {
+        guard !isClosed, !isStarting, !isSubmitting, pendingPassword == nil else { return .failure(.cancelled) }
+        if let error = CHIICHPasswordRequest.validationError(newPassword: newPassword, confirmation: confirmation) { return .failure(error) }
+        isStarting = true
+        defer { isStarting = false }
+        switch await prepare() {
+        case .success(.disabled): return .failure(.serverDisabled)
+        case .failure(let error): return .failure(error)
+        case .success(.allowed), .success(.unknown): break
+        }
+        guard !isClosed, !isSubmitting, pendingPassword == nil else { return .failure(.cancelled) }
+        operationID = UUID()
+        pendingPassword = newPassword
+        return await submit(authentication: nil)
+    }
+
+    func submitPassword(_ password: String) async -> Submission {
+        guard let challenge, challenge.availableStages.contains(.password) else { return .failure(.expiredChallenge) }
+        guard !password.isEmpty else { return .failure(.currentPasswordRequired) }
+        guard password.unicodeScalars.count <= 512 else { return .failure(.passwordTooLong) }
+        return await submit(authentication: .password(.init(identifier: context.accountID, password: password, session: challenge.session)))
+    }
+
+    func ssoPresentation() -> Result<CHIICHPasswordSSOPresentation, CHIICHPasswordError> {
+        guard !isClosed, !isSubmitting, sessionIsCurrent(), pendingPassword != nil else { return .failure(.sessionChanged) }
+        guard let challenge, challenge.availableStages.contains(.sso), let url = context.ssoURL(session: challenge.session) else {
+            return .failure(.expiredChallenge)
+        }
+        let nonce = UUID()
+        browserNonce = nonce
+        returnedBrowserNonce = nil
+        return .success(.init(id: nonce, url: url))
+    }
+
+    /// Closing the system browser says nothing about authentication. No POST is sent here.
+    func browserReturned(nonce: UUID) -> Bool {
+        guard !isClosed, sessionIsCurrent(), pendingPassword != nil, browserNonce == nonce else { return false }
+        returnedBrowserNonce = nonce
+        return true
+    }
+
+    func confirmSSO(nonce: UUID) async -> Submission {
+        guard let challenge, challenge.availableStages.contains(.sso),
+              browserNonce == nonce, returnedBrowserNonce == nonce else { return .failure(.expiredChallenge) }
+        returnedBrowserNonce = nil
+        return await submit(authentication: .session(challenge.session))
+    }
+
+    func finishCompletedChallenge() async -> Submission {
+        guard let challenge, challenge.isComplete else { return .failure(.expiredChallenge) }
+        return await submit(authentication: .session(challenge.session))
+    }
+
+    func cancel() {
+        isClosed = true
+        operationID = UUID()
+        clearSecrets()
+    }
+
+    func discardPendingChange() {
+        guard !isSubmitting else { return }
+        operationID = UUID()
+        clearSecrets()
+    }
+
+    // MARK: - Private
+
+    private func submit(authentication: CHIICHPasswordAuth?) async -> Submission {
+        guard !isClosed, !isSubmitting else { return .failure(.cancelled) }
+        guard sessionIsCurrent(), !Task.isCancelled else {
+            clearSecrets()
+            return .failure(.sessionChanged)
+        }
+        guard let pendingPassword else { return .failure(.expiredChallenge) }
+        if let authentication {
+            guard let challenge, authentication.sessionID.utf8.elementsEqual(challenge.session.utf8) else { return .failure(.expiredChallenge) }
+        }
+        isSubmitting = true
+        let currentOperation = operationID
+        defer { if operationID == currentOperation { isSubmitting = false } }
+        let result = await submitRequest(.init(newPassword: pendingPassword, authentication: authentication))
+        guard !isClosed, currentOperation == operationID else { return .failure(.cancelled) }
+        guard sessionIsCurrent(), !Task.isCancelled else {
+            clearSecrets()
+            return .failure(.sessionChanged)
+        }
+        switch result {
+        case .success(.success):
+            clearSecrets()
+            isClosed = true
+        case .success(.challenge(let updatedChallenge)):
+            guard updatedChallenge.isValid, updatedChallenge.canContinue else {
+                clearSecrets()
+                return .failure(.unsupportedAuthentication)
+            }
+            if let challenge, !updatedChallenge.session.utf8.elementsEqual(challenge.session.utf8) {
+                clearSecrets()
+                return .failure(.expiredChallenge)
+            }
+            challenge = updatedChallenge
+            browserNonce = nil
+            returnedBrowserNonce = nil
+        case .failure:
+            // A rejected/uncertain submission is never replayed. A new attempt is an explicit user action.
+            clearSecrets()
+        }
+        return result
+    }
+
+    private func clearSecrets() {
+        pendingPassword = nil
+        challenge = nil
+        browserNonce = nil
+        returnedBrowserNonce = nil
+    }
+}
