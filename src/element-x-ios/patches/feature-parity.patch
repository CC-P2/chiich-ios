+
+    @Test(arguments: ["ab", "admin", "aБв", "ivan_name"])
+    func invalidEditsCannotSendARename(_ name: String) async {
+        let fixture = Fixture()
+        await fixture.model.loadIfNeeded()
+        fixture.model.beginEditing()
