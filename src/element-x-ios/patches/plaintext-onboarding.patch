--- a/ElementX/Sources/FlowCoordinators/OnboardingFlowCoordinator.swift
+++ b/ElementX/Sources/FlowCoordinators/OnboardingFlowCoordinator.swift
@@ -132,6 +132,12 @@
     // MARK: - Private
     
     private var requiresVerification: Bool {
+        // CHIICH's existing plaintext policy must not lock an authenticated user
+        // out of ordinary chats. This only defers the blocking presentation:
+        // the SDK's verification state, keys and encrypted rooms stay unchanged.
+        // Recovery remains available in Settings, and the native gate applies
+        // again whenever the existing plaintext policy is not active.
+        guard !userSettings.app.forceDisableE2EE.publisher.value else { return false }
         guard userSession.sessionSecurityStatePublisher.value.verificationState != .verified else { return false }
         // We want to make sure onboarding finishes but also every time the user becomes unverified (e.g. account reset)
         return !userSettings.account.hasRunIdentityConfirmationOnboarding || userSession.sessionSecurityStatePublisher.value.verificationState == .unverified
