+private extension TimelineViewModel {
+    func updateCHIICHVisibility(_ itemID: TimelineItemIdentifier, appeared: Bool) {
+        if appeared {
+            chiichVisibleItems.insert(itemID)
+            if let event = chiichReceiverItems[itemID] {
+                userSession.chiichReceiverAI?.show(event, owner: chiichReceiverOwner)
+            }
+        } else {
+            chiichVisibleItems.remove(itemID)
+            if let eventID = itemID.eventID {
+                userSession.chiichReceiverAI?.hide(roomID: roomProxy.id, eventID: eventID, owner: chiichReceiverOwner)
+            }
+        }
+    }
+    
+    func updateCHIICHReceiverItems(_ items: [RoomTimelineItemProtocol], isSwitchingTimelines: Bool) {
+        guard let receiver = userSession.chiichReceiverAI else { return }
+        switch timelineController.timelineKind {
+        case .live, .detached, .thread: break
+        default: return
+        }
+        if isSwitchingTimelines {
+            receiver.removeOwner(chiichReceiverOwner)
+            chiichVisibleItems.removeAll()
+        }
+        var updated: [TimelineItemIdentifier: CHIICHReceiverAIEvent] = [:]
+        for item in items {
+            guard let event = item as? EventBasedTimelineItemProtocol, event.id.eventID != nil else { continue }
+            if CHIICHReceiverAITimeline.invalidateIfNeeded(event, roomID: roomProxy.id, receiver: receiver) {
+                continue
+            }
+            guard let descriptor = CHIICHReceiverAITimeline.event(from: event,
+                                                                  roomID: roomProxy.id,
+                                                                  ownUserID: roomProxy.ownUserID,
+                                                                  hideMedia: state.hideTimelineMedia,
+                                                                  editJSON: { timelineController.debugInfo(for: event.id).latestEditJSON }) else { continue }
+            updated[event.id] = descriptor
+            receiver.register(descriptor)
+            if chiichVisibleItems.contains(event.id) {
+                receiver.show(descriptor, owner: chiichReceiverOwner)
+            }
+        }
+        for id in chiichReceiverItems.keys where updated[id] == nil {
+            if let eventID = id.eventID {
+                receiver.hide(roomID: roomProxy.id, eventID: eventID, owner: chiichReceiverOwner)
+            }
+        }
+        chiichReceiverItems = updated
+    }
+}
