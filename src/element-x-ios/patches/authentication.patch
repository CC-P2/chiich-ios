+            return handler
+        }
+        let callback = try #require(SSOCallback(scheme: "one.chiich.app"))
+        let operation = Task { await service.beginSSOLogin(provider: .apple, callback: callback) }
+        await gate.waitUntilEntered()
+        operation.cancel()
+        await gate.release()
